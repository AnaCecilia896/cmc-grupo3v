# Template de secrets — cole os valores reais no painel do Streamlit Cloud.
# NÃO coloque os valores reais aqui (este arquivo é commitado).

# GitHub — necessário para persistir metas semanais de compras
# Crie um PAT em: https://github.com/settings/tokens (scope: repo > contents)
github_token = "ghp_..."
github_repo  = "seu-usuario/cmv-unidades"

# Senha master — vê todas as unidades
app_password = "CMV123"

# Senha por unidade — quando logar com uma dessas, o app abre direto naquela
# unidade e bloqueia a troca pra outras (gerente vê só a unidade dele).
[unit_passwords]
asa-norte    = "asanorte321"
asa-sul      = "asasul321"
aguas-claras = "aguasclaras321"
koji         = "koji321"
mane         = "mane321"
spq-norte    = "spqnorte321"
